__pycache__/
*.pyc
.venv/
venv/
.env
.claude/
*.egg-info/
.pytest_cache/
uv.lock

# Local capture / crack artifacts (never commit these)
*.pcap
*.pcapng
*.cap
*.hc22000
*.hccapx

# Local scratch, downloads and saved screenshots
/scratch/
/tmp/
screenshot_*.png

# Per-user task-knowledge notes: the knowledge/ folder ships only its README and
# .gitignore; the notes themselves are local memory and are never committed.
# (knowledge/.gitignore enforces the same rule from inside the folder.)
/knowledge/*
!/knowledge/.gitignore
!/knowledge/README.md
